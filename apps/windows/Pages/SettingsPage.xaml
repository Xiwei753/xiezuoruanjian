<Page
    x:Class="Sujian.Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SujianSurfaceBrush}">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="600">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"
                       Foreground="{DynamicResource SujianOnSurfaceBrush}" />

            <TextBlock Text="编辑器" Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{DynamicResource SujianOnSurfaceBrush}" />
            <NumberBox Header="字号" x:Name="FontSizeBox" Minimum="10" Maximum="36" Value="16" SpinButtonPlacementMode="Compact" />
            <NumberBox Header="行高倍数" x:Name="LineHeightBox" Minimum="1.0" Maximum="3.0" Value="1.5" SpinButtonPlacementMode="Compact" />
            <NumberBox Header="首行缩进（em）" x:Name="IndentBox" Minimum="0" Maximum="8" Value="2" SpinButtonPlacementMode="Compact" />
            <ToggleSwitch Header="自动保存" x:Name="AutoSaveToggle" IsOn="True" />
            <ToggleSwitch Header="首行自动缩进" x:Name="AutoIndentToggle" IsOn="True" />

            <TextBlock Text="动画" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"
                       Foreground="{DynamicResource SujianOnSurfaceBrush}" />
            <ToggleSwitch Header="打字动画" x:Name="TypingAnimToggle" IsOn="True" />
            <NumberBox Header="打字动画持续时间（ms）" x:Name="TypingAnimDurationBox" Minimum="30" Maximum="1000" Value="100" SpinButtonPlacementMode="Compact" />
            <ToggleSwitch Header="协同光标动画" x:Name="CoordinatedCursorAnimToggle" IsOn="True" />
            <NumberBox Header="整体动画时长（ms）" x:Name="CoordinatedDurationBox" Minimum="30" Maximum="1000" Value="100" SpinButtonPlacementMode="Compact" Visibility="Collapsed" />

            <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"
                       Foreground="{DynamicResource SujianOnSurfaceBrush}" />
            <RadioButtons Header="主题" x:Name="ThemeRadio" SelectedIndex="0">
                <RadioButton Content="跟随系统" />
                <RadioButton Content="浅色" />
                <RadioButton Content="深色" />
            </RadioButtons>

            <TextBlock Text="颜色主题" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"
                       Foreground="{DynamicResource SujianOnSurfaceBrush}" />
            <RadioButtons Header="配色来源" x:Name="ColorSourceRadio" SelectedIndex="0">
                <RadioButton Content="素笺默认" />
                <RadioButton Content="已保存的设备配色" />
            </RadioButtons>

            <ComboBox Header="内置主题" x:Name="BuiltinThemeCombo" Margin="0,8,0,0" />
            <ComboBox Header="设备配色" x:Name="PaletteRecordCombo" Margin="0,8,0,0" />

            <Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,16,0,0" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource SujianOnSurfaceVariantBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
