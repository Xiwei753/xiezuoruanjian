<Page
    x:Class="Sujian.Windows.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SujianSurfaceBrush}">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="600">
            <TextBlock Text="同步" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"
                       Foreground="{DynamicResource SujianOnSurfaceBrush}" />

            <TextBlock Text="远程仓库" Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{DynamicResource SujianOnSurfaceBrush}" />
            <TextBox Header="远程 URL" x:Name="RemoteUrlBox" PlaceholderText="https://github.com/..." />
            <PasswordBox Header="访问令牌" x:Name="AccessTokenBox" PlaceholderText="GitHub Personal Access Token" />
            <ToggleSwitch Header="自动同步" x:Name="AutoSyncToggle" IsOn="False" />
            <NumberBox Header="同步间隔（分钟）" x:Name="SyncIntervalBox" Minimum="1" Maximum="1440" Value="5" SpinButtonPlacementMode="Compact" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="保存配置" Click="SaveConfig_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="试运行" Click="DryRun_Click" />
                <Button Content="立即同步" Click="SyncNow_Click" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Foreground="{DynamicResource SujianOnSurfaceVariantBrush}" TextWrapping="Wrap" />
            <TextBox x:Name="ResultBox" Header="同步结果" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="200" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
