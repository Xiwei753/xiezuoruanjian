<Page
    x:Class="Sujian.Windows.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="600">
            <TextBlock Text="写作统计" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" HorizontalAlignment="Stretch">
                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="总字数" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TotalWordsText" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,8">
                    <StackPanel>
                        <TextBlock Text="今日字数" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TodayWordsText" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="本次字数" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SessionWordsText" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,8">
                    <StackPanel>
                        <TextBlock Text="连续天数" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StreakDaysText" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
