<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Writing app: do NOT backup/transfer manuscripts, sync tokens, logs, or crash files.
         Currently allowBackup=false, so this file is a placeholder for future use. -->
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
