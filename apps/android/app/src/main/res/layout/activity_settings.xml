<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/action_settings"
            app:navigationIcon="@drawable/ic_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ═══ 1. 外观 (Appearance) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="?attr/materialCardViewElevatedStyle"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_category_appearance"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <!-- Theme Mode — MaterialAutoCompleteTextView -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/pref_theme_mode">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Font Size -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_font_size"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvFontSizeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary"/>
                    </LinearLayout>

                    <!-- Font Size — range from Core settings_presentation: min=12, max=72, step=1 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sbFontSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="12.0"
                        android:valueTo="72.0"
                        android:stepSize="1.0"
                        android:layout_marginBottom="16dp"/>

                    <!-- Line Spacing -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_line_spacing"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvLineSpacingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary"/>
                    </LinearLayout>

                    <!-- Line Spacing — range from Core settings_presentation: min=1.0, max=3.0, step=0.1 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sbLineSpacing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1.0"
                        android:valueTo="3.0"
                        android:stepSize="0.1"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 2. 编辑器 (Editor) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="?attr/materialCardViewElevatedStyle"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_category_editor"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <!-- Auto Indent -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoIndent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_auto_indent"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Indent Width -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_auto_indent_width"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvAutoIndentWidthValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary"/>
                    </LinearLayout>

                    <!-- Indent Width — range from Core settings_presentation: min=0.0, max=8.0, step=0.5 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sbAutoIndentWidth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.0"
                        android:valueTo="8.0"
                        android:stepSize="0.5"
                        android:layout_marginBottom="24dp"/>

                    <!-- Typing Animation -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTypingAnimation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_editor_typing_animation"
                        android:layout_marginTop="8dp"/>

                    <!-- Typing Animation Duration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_editor_typing_animation_duration"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvTypingAnimationDurationValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary"/>
                    </LinearLayout>

                    <!-- Typing Animation Duration — range from Core settings_presentation: min=30, max=1000, step=10 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sbTypingAnimationDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="30.0"
                        android:valueTo="1000.0"
                        android:stepSize="10.0"/>

                    <!-- Smooth Cursor -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSmoothCursor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_editor_smooth_cursor"
                        android:layout_marginTop="8dp"/>

                    <!-- Smooth Cursor Duration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_editor_smooth_cursor_duration"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvSmoothCursorDurationValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary"/>
                    </LinearLayout>

                    <!-- Smooth Cursor Duration — range from Core settings_presentation: min=30, max=1000, step=10 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sbSmoothCursorDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="30.0"
                        android:valueTo="1000.0"
                        android:stepSize="10.0"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 3. 保存 (Save) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="?attr/materialCardViewElevatedStyle"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_category_save"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoSave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_auto_save"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_auto_save_delay"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvAutoSaveDelayValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary"/>
                    </LinearLayout>

                    <!-- Auto Save Delay — range from Core settings_presentation: min=1, max=10, step=1 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sbAutoSaveDelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1.0"
                        android:valueTo="10.0"
                        android:stepSize="1.0"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 4. 同步 (Sync) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="?attr/materialCardViewElevatedStyle"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_category_sync"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchEnableSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_enable_sync"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etGithubRepo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/pref_github_repo"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBranch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/pref_branch"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHttpsToken"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:hint="@string/pref_https_token"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvTokenStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/token_not_configured"
                        android:textColor="?attr/colorError"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_auto_sync"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_sync_interval"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvSyncIntervalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary"/>
                    </LinearLayout>

                    <!-- Sync Interval — range from Core settings_presentation: min=60, max=3600, step=60 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sbSyncInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="60.0"
                        android:valueTo="3600.0"
                        android:stepSize="60.0"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="fill"
                        android:layout_marginBottom="24dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDryRun"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/btn_dry_run" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestConnection"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/btn_test_connection" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPerformSync"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_perform_sync" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 5. AI ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="?attr/materialCardViewElevatedStyle"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvAiSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_category_ai"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAiEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_ai_enabled"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 实验室 (Laboratory) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="?attr/materialCardViewElevatedStyle"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="实验室"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchExperimentalFullscreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="沉浸式全屏"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="隐藏系统状态栏/导航栏，滑动边缘会临时显示系统栏，可能影响刘海屏/手势区。"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 6. 诊断与日志 (Diagnostics) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="?attr/materialCardViewElevatedStyle"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_category_diagnostics"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDiagnosticsEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_diagnostics_enabled"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDiagnosticsVerbose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_diagnostics_verbose"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportDiagnostics"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/btn_export_diagnostics" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLogs"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/btn_clear_logs" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyDeviceInfo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_copy_device_info" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 7. 关于/高级 (About) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="?attr/materialCardViewElevatedStyle"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_category_about"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_workspace_path"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvWorkspacePath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_version_info"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvVersionInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_version_desc"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:text="@string/about_btn_text"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActionRegistry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:text="@string/action_registry_entry" />

