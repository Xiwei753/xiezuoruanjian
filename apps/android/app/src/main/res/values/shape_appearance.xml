<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cross-platform UI token: radius -->
    <dimen name="radius_xs">4dp</dimen>
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_xl">28dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- Component shape tokens -->
    <style name="ShapeAppearance.Sujian.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>
    <style name="ShapeAppearance.Sujian.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>
    <style name="ShapeAppearance.Sujian.FAB" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>
    <style name="ShapeAppearance.Sujian.BottomBar" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>
    <style name="ShapeAppearance.Sujian.InputField" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <!-- Elevation tokens -->
    <dimen name="elevation_0">0dp</dimen>
    <dimen name="elevation_1">1dp</dimen>
    <dimen name="elevation_2">3dp</dimen>
    <dimen name="elevation_3">6dp</dimen>
</resources>
