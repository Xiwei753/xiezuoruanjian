{
  app: {
    signingConfigs: [
      {
        name: 'default',
        type: 'HarmonyOS',
        material: {
          storeFile: '',
          storePassword: '',
          keyAlias: '',
          keyPassword: '',
          signAlg: 'SHA256withECDSA',
          profile: '',
          certpath: ''
        }
      },
      {
        name: 'acl',
        type: 'HarmonyOS',
        material: {
          storeFile: '',
          storePassword: '',
          keyAlias: '',
          keyPassword: '',
          signAlg: 'SHA256withECDSA',
          profile: '',
          certpath: ''
        }
      },
    ],
    products: [
      {
        name: 'default',
        signingConfig: 'default',
        compatibleSdkVersion: '5.0.0(12)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
          },
          // privacy_acl 作为 HSP 依赖被 entry 模块全局声明（oh-package.json5），
          // hvigor 要求依赖模块的 target 应用于消费模块的所有 product。
          // 普通 default product 不使用 DLP 防窥能力，通过 removePermissions
          // 移除 privacy_acl 引入的 ohos.permission.DLP_GET_HIDE_STATUS。
          removePermissions: [
            {
              name: 'ohos.permission.DLP_GET_HIDE_STATUS',
            },
          ],
        },
        targetSdkVersion: '26.0.0',
      },
      {
        name: 'acl',
        signingConfig: 'acl',
        compatibleSdkVersion: '5.0.0(12)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
          },
        },
        targetSdkVersion: '26.0.0',
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
        {
          name: 'acl',
          applyToProducts: [
            'acl',
          ],
        },
      ],
    },
    {
      name: 'privacy_acl',
      srcPath: './privacy_acl',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
            'acl',
          ],
        },
      ],
    },
  ],
}
