// ── Editor Visual Transaction DTOs ──

enum VisualCoordinateModeDto {
    "Baseline",
};

dictionary CursorRectDto {
    f64 x;
    f64 top;
    f64 bottom;
    f64 baseline_y;
};

dictionary GlyphRectDto {
    f64 x;
    f64 y;
    f64 w;
    f64 h;
    string char_;
    f64 baseline_y;
    u64 byte_start;
    u64 byte_end;
};

dictionary EditorVisualTransactionDto {
    u64 id;
    EditorAnimationKindDto kind;
    EditorTransactionCauseDto cause;
    string old_text;
    string new_text;
    u32 old_selection_anchor;
    u32 old_selection_head;
    u32 new_selection_anchor;
    u32 new_selection_head;
    u32 inserted_range_start;
    u32 inserted_range_end;
    boolean has_inserted_range;
    u32 deleted_range_start;
    u32 deleted_range_end;
    boolean has_deleted_range;
    AnimationModeDto animation_mode;
    u64 duration_ms;
    VisualCoordinateModeDto coordinate_mode;
};

// ── #535: Editor V2 Kernel DTOs ──

enum EditorOperationKindDto {
    "Insert",
    "Delete",
    "Replace",
    "CursorOnly",
    "CompositionUpdate",
    "CompositionCommit",
    "CompositionCancel",
    "Load",
    "Format",
};

dictionary CoordinatedCursorDto {
    u32 old_byte_offset;
    u32 new_byte_offset;
    boolean should_animate;
};

dictionary EditorVisualIntentDto {
    EditorTransactionCauseDto cause;
    EditorOperationKindDto operation_kind;
    sequence<EditorByteRangeDto> old_affected_byte_ranges;
    sequence<EditorByteRangeDto> new_affected_byte_ranges;
    AnimationModeDto animation_mode;
    u64 duration_ms;
    CoordinatedCursorDto coordinated_cursor;
};

dictionary EditorByteRangeDto {
    u32 start;
    u32 end_exclusive;
};

dictionary DisplayPatchDto {
    u64 base_revision;
    u64 new_revision;
    u32 replace_byte_start;
    u32 replace_byte_end_exclusive;
    string inserted_text;
    u32 resulting_selection_start;
    u32 resulting_selection_end;
};

dictionary EditorEditResultDto {
    u64 transaction_id;
    u64 base_revision;
    u64 new_revision;
    sequence<DisplayPatchDto> display_patches;
    u32 old_selection_start;
    u32 old_selection_end;
    u32 new_selection_start;
    u32 new_selection_end;
    EditorVisualIntentDto visual_intent;
};
