namespace writer_core {
    string perform_dummy_action();
};

dictionary AiActionResponse {
    string display_text;
    sequence<AiAction> actions;
};

dictionary AiAction {
    string label;
    AiActionType action_type;
    string payload;
};

enum AiActionType {
    "Navigate",
    "ApplySetting",
    "InsertText",
    "ReplaceText",
    "RunCommand",
    "Custom",
};

dictionary ProjectDto {
    string id;
    string title;
    string created_at;
    string updated_at;
};

dictionary ProjectStatsDto {
    u32 total_word_count;
    u32 volume_count;
    u32 chapter_count;
};

dictionary VolumeDto {
    string id;
    string title;
    string created_at;
    string updated_at;
    i32 order;
};

dictionary ChapterMetaDto {
    string id;
    string title;
    string created_at;
    string updated_at;
    i32 order;
    u32 word_count;
    string hash;
    string? note;
};

dictionary ChapterContentDto {
    ChapterMetaDto meta;
    string content;
};

dictionary ChapterSaveReceiptDto {
    string chapter_relative_path;
    u32 content_len;
    string content_hash;
    string meta_hash;
    string updated_at;
    u32 word_count;
};

dictionary RecentEditDto {
    string project_id;
    string volume_id;
    string chapter_id;
    string timestamp;
};

dictionary LocalSettingsDto {
    string? theme_mode;
    string? locale;
    boolean auto_save_enabled;
    f32 editor_font_size;
    f32 editor_line_spacing_multiplier;
    f32 window_width;
    f32 window_height;
    u64 auto_save_delay_ms;
    boolean auto_indent_enabled;
    f32 auto_indent_width;
    boolean editor_typing_animation_enabled;
    boolean editor_smooth_cursor_enabled;
    u64 editor_typing_animation_duration_ms;
    u64 editor_smooth_cursor_duration_ms;
    boolean ai_enabled;
    string? stats_device_id;
    f64 desktop_sidebar_width;
    f64 desktop_editor_width;
};

dictionary SyncableSettingsDto {
    f64 font_size;
    string theme_mode;
    string monet_color;
};

dictionary SyncConfigDto {
    boolean enabled;
    string backend_type;
    string remote_url;
    string transport;
    string branch;
    boolean auto_sync;
    u32 sync_interval_seconds;
    boolean proxy_enabled;
    string proxy_type;
    string proxy_host;
    u16 proxy_port;
    string username;
    boolean android_has_internet_permission;
    boolean android_has_access_network_state_permission;
};

dictionary SyncSecretsDto {
    string? token;
};

dictionary SyncConflictDto {
    string local_path;
    string remote_path;
    string local_hash;
    string remote_hash;
    string base_hash;
    i64 created_at;
    string description;
};

dictionary SyncStateDto {
    string status;
    string? remote_url;
    string? backend_type;
    string? transport;
    string? last_synced_commit;
    i64? last_sync_time;
    string? last_error;
    string? last_successful_network_mode;
    sequence<SyncConflictDto>? conflicts;
};

dictionary NetworkProbeResultDto {
    string mode;
    boolean success;
    string status;
    string message;
    string? raw_error;
};

dictionary SyncDiagnosticsResultDto {
    boolean success;
    string backend_type;
    boolean android_has_internet_permission;
    boolean android_has_access_network_state_permission;
    string android_network_state;
    boolean tcp_probe_ok;
    string tcp_probe_status;
    boolean http_connect_probe_ok;
    string http_connect_probe_status;
    boolean libgit2_probe_ok;
    string libgit2_probe_status;
    boolean network_ok;
    boolean auth_ok;
    boolean repo_ok;
    boolean branch_ok;
    string network_status;
    string auth_status;
    string repo_status;
    string branch_status;
    string remote_url_sanitized;
    string transport;
    string error_category;
    string user_message;
    string? raw_error;
    string? chosen_network_mode;
    sequence<NetworkProbeResultDto>? network_probe_summary;
};

dictionary SyncPlanDto {
    sequence<string> files_to_upload;
    sequence<string> files_to_download;
    sequence<string> files_to_delete_local;
    sequence<string> files_to_delete_remote;
    sequence<string> ignored_files;
    sequence<string> conflicts;
};

dictionary SyncResultDto {
    string status;
    sequence<string> uploaded_files;
    sequence<string> downloaded_files;
    sequence<string> local_deletes;
    sequence<string> remote_deletes;
    sequence<string> overwritten_files;
    sequence<string> ignored_files;
    sequence<SyncConflictDto> conflicts;
    string? commit_hash;
    string? error;
    string? error_category;
    string first_sync_mode;
    string? user_message;
    string? chosen_network_mode;
    sequence<NetworkProbeResultDto>? network_probe_summary;
};

[Error]
enum WriterError {
    "Io",
    "Json",
    "InvalidWorkspace",
    "ProjectNotFound",
    "VolumeNotFound",
    "ChapterNotFound",
    "EmptyOverwriteBlocked",
    "NotImplemented",
    "RefuseToDeleteWorkspaceRoot",
    "InvalidDeleteTarget",
    "SyncConflict",
    "SyncFailed",
    "Other"
};

enum PlatformDto {
    "Linux",
    "Android",
};

dictionary DateRangeDto {
    string start_date;
    string end_date;
};

dictionary WritingStatsSummaryDto {
    DateRangeDto range;
    u64 total_human_typed_chars;
    u64 total_pasted_chars;
    u64 total_deleted_chars;
    u64 total_ai_inserted_chars;
    i64 total_net_delta_chars;
    u64 total_active_seconds;
    u32 total_sessions;
    u32 days_count;
};

dictionary ProjectStatsRecordDto {
    string project_id;
    u64 human_typed_chars;
    u64 pasted_chars;
    u64 deleted_chars;
    u64 ai_inserted_chars;
    i64 net_delta_chars;
    u64 active_seconds;
};

dictionary ProjectStatsSummaryDto {
    DateRangeDto range;
    sequence<ProjectStatsRecordDto> projects;
};

dictionary ChapterStatsRecordDto {
    string chapter_id;
    u64 human_typed_chars;
    u64 pasted_chars;
    u64 deleted_chars;
    u64 ai_inserted_chars;
    i64 net_delta_chars;
    u64 active_seconds;
};

dictionary ChapterStatsSummaryDto {
    DateRangeDto range;
    sequence<ChapterStatsRecordDto> chapters;
};

dictionary DeviceStatsRecordDto {
    string device_id;
    PlatformDto platform;
    u64 human_typed_chars;
    u64 pasted_chars;
    u64 deleted_chars;
    u64 ai_inserted_chars;
    i64 net_delta_chars;
    u64 active_seconds;
    u32 sessions_count;
};

dictionary DeviceStatsSummaryDto {
    DateRangeDto range;
    sequence<DeviceStatsRecordDto> devices;
};

dictionary SpeedCurvePointDto {
    i64 start_ms;
    i64 end_ms;
    u32 chars_typed;
    float chars_per_minute;
};

dictionary SpeedCurveSummaryDto {
    DateRangeDto range;
    u32 bucket_minutes;
    sequence<SpeedCurvePointDto> buckets;
};

// ============================================================
// MindMap types
// ============================================================

dictionary MindMapSnapshotDto {
    string project_id;
    string layout_kind;
    sequence<MindMapSnapshotNodeDto> nodes;
    sequence<MindMapSnapshotEdgeDto> edges;
    MindMapBoundsDto bounds;
    u64 generated_at;
};

dictionary MindMapSnapshotNodeDto {
    string id;
    string title;
    MindMapNodeKindDto kind;
    float x;
    float y;
    float width;
    float height;
    float radius;
    boolean collapsed;
    u32 anchor_count;
    boolean broken_link;
    sequence<string> tags;
};

dictionary MindMapSnapshotEdgeDto {
    string id;
    string from;
    string to;
    string kind;
    string? label;
};

dictionary MindMapBoundsDto {
    float min_x;
    float min_y;
    float max_x;
    float max_y;
};

dictionary MindMapGraphDto {
    u32 schema_version;
    string id;
    string project_id;
    string title;
    sequence<MindMapGraphNodeDto> nodes;
    sequence<MindMapGraphEdgeDto> edges;
    sequence<MindMapAnchorDto> anchors;
    sequence<MindMapLinkDto> links;
    u64 created_at;
    u64 updated_at;
};

dictionary MindMapGraphNodeDto {
    string id;
    string title;
    MindMapNodeKindDto kind;
    string? payload;
    sequence<string> tags;
    u64 created_at;
    u64 updated_at;
};

dictionary MindMapGraphEdgeDto {
    string id;
    string from;
    string to;
    MindMapEdgeKindDto kind;
    string? label;
    string? payload;
    u64 created_at;
    u64 updated_at;
};

dictionary MindMapAnchorDto {
    string id;
    string project_id;
    string chapter_id;
    u32 start_offset;
    u32 end_offset;
    string selected_text;
    string prefix_text;
    string suffix_text;
    string checksum;
    u64 created_at;
    u64 updated_at;
};

dictionary MindMapLinkDto {
    string id;
    string node_id;
    string anchor_id;
    string kind;
    u64 created_at;
    u64 updated_at;
};

dictionary MindMapLayoutDto {
    MindMapLayoutKindDto kind;
    sequence<MindMapLayoutNodeDto> nodes;
};

dictionary MindMapLayoutNodeDto {
    string node_id;
    float x;
    float y;
    float width;
    float height;
    float radius;
    boolean collapsed;
    i32 z_index;
};

dictionary MindMapGraphMetadataDto {
    string id;
    string title;
    u64 created_at;
    u64 updated_at;
};

dictionary MindMapGraphsListDto {
    string? default_graph_id;
    sequence<MindMapGraphMetadataDto> graphs;
};

enum MindMapNodeKindDto {
    "Project",
    "Volume",
    "Chapter",
    "TextAnchor",
    "Character",
    "Event",
    "Location",
    "Item",
    "Concept",
    "Theme",
    "Note",
    "Organization",
    "Timeline",
    "Plot",
    "Foreshadowing",
    "Custom",
};

enum MindMapEdgeKindDto {
    "Contains",
    "References",
    "AppearsIn",
    "Causes",
    "RelatedTo",
    "LocatedAt",
    "CharacterRelation",
    "Timeline",
    "Foreshadows",
    "Resolves",
    "DependsOn",
    "ConflictsWith",
    "Custom",
};

enum MindMapLayoutKindDto {
    "AutoRadial",
    "HorizontalTree",
    "Freeform",
    "Timeline",
    "Relationship",
    "Custom",
};

// ============================================================
// StarMap types
// ============================================================

dictionary StarMapMetaDto {
    string starmap_id;
    string title;
    string description;
    string? project_id;
    string? parent_starmap_id;
    boolean is_main_for_project;
    string accent_color;
    u64 created_at;
    u64 updated_at;
    u32 node_count;
    u32 edge_count;
    u32 linked_chapter_count;
    u32 child_starmap_count;
};

dictionary StarMapGraphDto {
    u32 schema_version;
    string id;
    string starmap_id;
    string title;
    sequence<StarMapNodeDto> nodes;
    sequence<StarMapEdgeDto> edges;
    sequence<StarMapEmbedDto> embeds;
    sequence<StarMapLinkDto> links;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapNodeDto {
    string id;
    string title;
    StarMapNodeKindDto kind;
    string? payload;
    sequence<string> tags;
    StarMapNodeContentDto content;
    sequence<StarMapAnchorDto> anchors;
    StarMapPortalDto? portal;
    StarMapDisplayPolicyDto display_policy;
    StarMapOpenBehaviorDto open_behavior;
    StarMapProvenanceDto provenance;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapNodeContentDto {
    string kind;
    string? summary;
    string? body;
    string? project_id;
    string? volume_id;
    string? chapter_id;
    u32? range_start;
    u32? range_end;
    string? entity_type;
    string? entity_id;
    string? uri;
    string? label;
};

dictionary StarMapAnchorDto {
    string anchor_id;
    StarMapAnchorTargetDto target;
    string? label;
    StarMapAnchorRoleDto role;
};

dictionary StarMapAnchorTargetDto {
    string kind;
    string? project_id;
    string? volume_id;
    string? chapter_id;
    u32? range_start;
    u32? range_end;
    string? entity_id;
    string? entity_type;
    string? starmap_id;
    string? uri;
    string? payload;
};

dictionary StarMapPortalDto {
    string target_starmap_id;
    StarMapDeepTargetDto? deep_target;
    StarMapPortalModeDto mode;
    StarMapPortalPreviewPolicyDto preview_policy;
};

dictionary StarMapDisplayPolicyDto {
    float importance;
    float min_visible_scale;
    float title_scale;
    float summary_scale;
    float detail_scale;
    u32 max_preview_chars;
    float min_readable_px;
};

dictionary StarMapProvenanceDto {
    StarMapSourceKindDto source;
    string? source_id;
    string? generated_by;
    string? prompt_id;
    StarMapReviewStatusDto review_status;
    string? created_from_anchor;
};

dictionary StarMapDeepTargetDto {
    string starmap_id;
    sequence<StarMapPathSegmentDto> path;
    StarMapTargetDetailDto target;
};

dictionary StarMapPathSegmentDto {
    string kind;
    string? starmap_id;
    string? node_id;
};

dictionary StarMapEdgeEndpointDto {
    string kind;
    string? node_id;
    string? anchor_id;
    StarMapDeepTargetDto? target;
};

dictionary StarMapEdgeDto {
    string id;
    string? from;
    string? to;
    StarMapEdgeKindDto kind;
    string? label;
    string? payload;
    StarMapDeepTargetDto? from_target;
    StarMapDeepTargetDto? to_target;
    StarMapEdgeEndpointDto? from_endpoint;
    StarMapEdgeEndpointDto? to_endpoint;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapEmbedPlacementDto {
    float x;
    float y;
    float width;
    float height;
    float scale;
    i32 z_index;
    boolean collapsed;
};

dictionary StarMapEmbedViewportDto {
    float scale;
    float offset_x;
    float offset_y;
};

dictionary StarMapEmbedDto {
    string instance_id;
    string target_starmap_id;
    string? label;
    StarMapDisplayPolicyDto display_policy;
    StarMapOpenBehaviorDto open_behavior;
    StarMapEmbedPlacementDto placement;
    StarMapEmbedViewportDto target_viewport;
    string? source_node_id;
    StarMapEndpointDto? host_endpoint;
    StarMapProvenanceDto provenance;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapLinkDto {
    string link_id;
    StarMapEndpointDto source;
    StarMapDeepTargetDto target;
    string? label;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapLayoutDto {
    StarMapLayoutKindDto kind;
    sequence<StarMapLayoutNodeDto> nodes;
};

dictionary StarMapLayoutNodeDto {
    string node_id;
    float x;
    float y;
    float width;
    float height;
    float radius;
    boolean collapsed;
    i32 z_index;
    float scale;
    float depth;
    float focus_weight;
    string? orbit_group;
};

dictionary StarMapReferenceDto {
    string host_starmap_id;
    string host_title;
    string ref_type;
    string ref_id;
    string target_starmap_id;
};

dictionary StarMapTargetDetailDto {
    string kind;
    string? node_id;
    string? anchor_id;
    string? project_id;
    string? volume_id;
    string? chapter_id;
    u32? range_start;
    u32? range_end;
    string? entity_type;
    string? entity_id;
    string? uri;
};

dictionary StarMapEndpointDto {
    string kind;
    string? node_id;
    string? anchor_id;
};

dictionary StarMapViewportDto {
    float scale;
    float offset_x;
    float offset_y;
    float width;
    float height;
};

dictionary StarMapEmbedPatchInputDto {
    string? label;
    boolean clear_label;
    StarMapDisplayPolicyDto? display_policy;
    StarMapOpenBehaviorDto? open_behavior;
    StarMapViewportDto? viewport;
    boolean clear_viewport;
    StarMapEmbedPlacementDto? placement;
    boolean clear_placement;
    StarMapEmbedViewportDto? target_viewport;
    boolean clear_target_viewport;
    string? source_node_id;
    boolean clear_source_node_id;
    string? host_anchor;
    boolean clear_host_anchor;
    StarMapEndpointDto? host_endpoint;
    boolean clear_host_endpoint;
};

dictionary StarMapLinkPatchInputDto {
    StarMapEndpointDto? source;
    StarMapDeepTargetDto? target;
    string? label;
    boolean clear_label;
};

enum StarMapNodeKindDto {
    "Character",
    "Event",
    "Location",
    "Item",
    "Concept",
    "Theme",
    "Note",
    "Organization",
    "Timeline",
    "Plot",
    "Foreshadowing",
    "Chapter",
    "Custom",
};

enum StarMapEdgeKindDto {
    "Contains",
    "References",
    "AppearsIn",
    "Causes",
    "RelatedTo",
    "LocatedAt",
    "CharacterRelation",
    "Timeline",
    "Foreshadows",
