    // ── #535: Editor V2 Kernel ──

    EditorEditResultDto editor_kernel_insert(u32 byte_offset, string text, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto editor_kernel_delete(u32 byte_start, u32 byte_end_exclusive, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto editor_kernel_replace(u32 byte_start, u32 byte_end_exclusive, string replacement_text, string original_text, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto editor_kernel_set_selection(u32 anchor_byte_offset, u32 head_byte_offset, u64 expected_revision);
    EditorEditResultDto editor_kernel_undo(u64 expected_revision);
    EditorEditResultDto editor_kernel_redo(u64 expected_revision);
    EditorEditResultDto editor_kernel_load_text(string text, u32 cursor_byte_offset);
     EditorEditResultDto editor_kernel_commit_text(u32 byte_start, u32 byte_end_exclusive, string replacement_text, u32 resulting_selection_anchor, u32 resulting_selection_head, u64 composition_session_id, u64 composition_base_revision, u64 composition_generation, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto editor_kernel_delete_surrounding(u32 before_byte_start, u32 before_byte_end_exclusive, u32 after_byte_start, u32 after_byte_end_exclusive, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto editor_kernel_begin_composition(u32 replace_start, u32 replace_end_exclusive, u64 expected_revision);
    EditorEditResultDto editor_kernel_update_composition(u64 composition_session_id, u64 composition_generation, string new_preedit_text, u32 new_preedit_cursor_offset, u64 expected_revision);
    EditorEditResultDto editor_kernel_finish_composition(u64 composition_session_id, u64 composition_generation, u64 expected_revision);
    EditorEditResultDto editor_kernel_cancel_composition(u64 composition_session_id, u64 composition_generation, u64 expected_revision);
    void editor_kernel_set_animation_enabled(u8 enabled);
    void editor_kernel_set_animation_duration_ms(u64 duration_ms);
    string editor_kernel_get_text();
    u64 editor_kernel_get_revision();
    u32 editor_kernel_get_cursor();
    u32 editor_kernel_get_selection_anchor();
    EditorSessionSnapshotDto editor_kernel_session_snapshot();
    // #606: grapheme cluster 边界由 Core 唯一计算，平台端不再依赖 ICU BreakIterator
    u32 editor_kernel_previous_grapheme_boundary(u32 byte_offset);
    u32 editor_kernel_next_grapheme_boundary(u32 byte_offset);
    // #606: rebase slice 逻辑对应关系由 Core 唯一计算，平台端不再自己匹配。
    // offset_map 为本次事务的旧正文 → 新正文偏移映射（EditorVisualIntentDto.offset_map），
    // 用于旧/新 slice range 坐标不同时的 OffsetMapMatched 匹配。
    sequence<RebaseSliceMappingDto> editor_kernel_compute_rebase_slice_mappings(
        sequence<AnimatedSliceRoleDto> old_slice_roles,
        sequence<EditorByteRangeDto> old_slice_byte_ranges,
        sequence<AnimatedSliceRoleDto> new_slice_roles,
        sequence<EditorByteRangeDto> new_slice_byte_ranges,
        OffsetMapDto? offset_map
    );
    EditorEditResultDto editor_kernel_replace_all(string search, string replacement, u64 expected_revision);
    EditorEditResultDto editor_kernel_insert_line_break(u32 byte_offset, u8 auto_indent_enabled, EditorTransactionCauseDto cause, u64 expected_revision);

    // ── #541: Text Edit Session API ──

    u64? text_edit_session_create(string target_id, string initial_text, u32 initial_cursor_byte_offset, u8 is_persistent);
    u8 text_edit_session_close(u64 session_id);
    u8 text_edit_session_reset(u64 session_id, string text, u32 cursor_byte_offset);
    EditorEditResultDto text_edit_session_insert(u64 session_id, u32 byte_offset, string text, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto text_edit_session_delete(u64 session_id, u32 byte_start, u32 byte_end_exclusive, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto text_edit_session_replace(u64 session_id, u32 byte_start, u32 byte_end_exclusive, string replacement_text, string original_text, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto text_edit_session_set_selection(u64 session_id, u32 anchor_byte_offset, u32 head_byte_offset, u64 expected_revision);
    EditorEditResultDto text_edit_session_undo(u64 session_id, u64 expected_revision);
    EditorEditResultDto text_edit_session_redo(u64 session_id, u64 expected_revision);
    EditorEditResultDto text_edit_session_load_text(u64 session_id, string text, u32 cursor_byte_offset);
    EditorEditResultDto text_edit_session_commit_text(u64 session_id, u32 byte_start, u32 byte_end_exclusive, string replacement_text, u32 resulting_selection_anchor, u32 resulting_selection_head, u64 composition_session_id, u64 composition_base_revision, u64 composition_generation, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto text_edit_session_delete_surrounding(u64 session_id, u32 before_byte_start, u32 before_byte_end_exclusive, u32 after_byte_start, u32 after_byte_end_exclusive, EditorTransactionCauseDto cause, u64 expected_revision);
    EditorEditResultDto text_edit_session_begin_composition(u64 session_id, u32 replace_start, u32 replace_end_exclusive, u64 expected_revision);
    EditorEditResultDto text_edit_session_update_composition(u64 session_id, u64 composition_session_id, u64 composition_generation, string new_preedit_text, u32 new_preedit_cursor_offset, u64 expected_revision);
    EditorEditResultDto text_edit_session_finish_composition(u64 session_id, u64 composition_session_id, u64 composition_generation, u64 expected_revision);
    EditorEditResultDto text_edit_session_cancel_composition(u64 session_id, u64 composition_session_id, u64 composition_generation, u64 expected_revision);
    void text_edit_session_set_animation_enabled(u64 session_id, u8 enabled);
    void text_edit_session_set_animation_duration_ms(u64 session_id, u64 duration_ms);
    // #606: grapheme cluster 边界由 Core 唯一计算（session-scoped 版本）。
    // 平台端 TextEditSessionBridge 通过这两个方法调用 Core 的 unicode_segmentation，
    // 不再依赖 ICU BreakIterator。
    u32 text_edit_session_previous_grapheme_boundary(u64 session_id, u32 byte_offset);
    u32 text_edit_session_next_grapheme_boundary(u64 session_id, u32 byte_offset);
    // #606: rebase slice 逻辑对应关系由 Core 唯一计算（session-scoped 版本）。
    // offset_map 为本次事务的旧正文 → 新正文偏移映射（EditorVisualIntentDto.offset_map），
    // 用于旧/新 slice range 坐标不同时的 OffsetMapMatched 匹配。
    sequence<RebaseSliceMappingDto> text_edit_session_compute_rebase_slice_mappings(
        u64 session_id,
        sequence<AnimatedSliceRoleDto> old_slice_roles,
        sequence<EditorByteRangeDto> old_slice_byte_ranges,
        sequence<AnimatedSliceRoleDto> new_slice_roles,
        sequence<EditorByteRangeDto> new_slice_byte_ranges,
        OffsetMapDto? offset_map
    );
    string text_edit_session_get_text(u64 session_id);
    u64 text_edit_session_get_revision(u64 session_id);
    EditorSessionSnapshotDto text_edit_session_snapshot(u64 session_id);
    EditorEditResultDto text_edit_session_replace_all(u64 session_id, string search, string replacement, u64 expected_revision);
    EditorEditResultDto text_edit_session_insert_line_break(u64 session_id, u32 byte_offset, u8 auto_indent_enabled, EditorTransactionCauseDto cause, u64 expected_revision);

    // ── Search Index ──

    [Throws=WriterError]
    string global_search(string query, string scope, u32 limit, string? cursor);

    [Throws=WriterError]
    string rebuild_search_index(string? project_id);

    [Throws=WriterError]
    string get_search_index_status();

    [Throws=WriterError]
    boolean enqueue_search_update(string action, string object_id, string scope, string title, string body);
};

// ── Layout Contract DTOs（#610） ──

enum ShellModeDto {
    "SinglePane",
    "SupportingPane",
    "TwoPane",
    "ThreePane",
};

enum WorkspacePaneModeDto {
    "SinglePane",
    "ListDetail",
    "ThreePane",
};

enum PointerClassDto {
    "Unknown",
    "Touch",
    "Stylus",
    "Mouse",
};

dictionary WindowCapabilitiesDto {
    u8 available_pane_count;
    boolean has_separating_fold;
    PointerClassDto pointer_class;
    boolean keyboard_visible;
};

dictionary LayoutContractDto {
    ShellModeDto shell_mode;
    WorkspacePaneModeDto workspace_pane_mode;
    boolean show_primary_navigation;
};

// ── Screen Contract DTOs ──

enum ScreenRoleDto {
    "Home",
    "ProjectList",
    "ProjectWorkspace",
    "Writing",
    "StarMap",
    "Stats",
    "Settings",
    "Sync"
};

enum PaneRoleDto {
    "PrimaryList",
    "Detail",
    "Editor",
    "Inspector",
    "Drawer",
    "Supporting"
};

enum ActionRoleDto {
    "Back",
    "CreateProject",
    "CreateVolume",
    "CreateChapter",
    "Delete",
    "Rename",
    "MoveEarlier",
    "MoveLater",
    "Settings",
    "Sync",
    "Search"
};

// #610 评论二：平台无关的业务目标身份。
enum ActionTargetDto {
    "App",
    "Project",
    "Volume",
    "Chapter"
};

enum ActionRegionDto {
    "HeaderLeading",
    "HeaderTrailing",
    "PrimaryAction",
    "ListHeader",
    "ItemTrailing",
    "Context",
    "EmptyState"
};

dictionary ActionSlotDto {
    ActionRoleDto role;
    ActionTargetDto target;
    ActionRegionDto region;
    u16 order;
    boolean requires_confirmation;
};

dictionary ScreenPolicyDto {
    ScreenRoleDto screen_role;
    sequence<ActionSlotDto> action_slots;
};

// ── Editor Animation DTOs ──

enum AnimationModeDto {
    "GlyphAnimation",
    "ClusterAnimation",
    "RunAnimation",
    "LineReflowAnimation",
    "SnapshotAnimation",
    "SystemSuppressed",
};

enum EditorTransactionCauseDto {
    "Typing",
    "Delete",
    "ImeComposition",
    "TypingCommit",
    "Paste",
    "Undo",
    "Redo",
    "Load",
    "Format",
    "Programmatic",
};

// ── #535: Editor V2 Kernel DTOs ──

enum EditorOperationKindDto {
    "Insert",
    "Delete",
    "Replace",
    "CursorOnly",
    "CompositionUpdate",
    "CompositionCommit",
    "CompositionCancel",
    "Load",
    "Format",
};

dictionary CoordinatedCursorDto {
    u32 old_byte_offset;
    u32 new_byte_offset;
    boolean should_animate;
};

dictionary OffsetMapEntryDto {
    u32 old_byte_offset;
    u32 new_byte_offset;
    u32 length;
    OffsetMapKindDto kind;
};

enum OffsetMapKindDto {
    "Identity",
    "Shifted",
};

dictionary OffsetMapDto {
    sequence<OffsetMapEntryDto> entries;
};

dictionary EditorVisualIntentDto {
    EditorTransactionCauseDto cause;
    EditorOperationKindDto operation_kind;
    sequence<EditorByteRangeDto> old_affected_byte_ranges;
    sequence<EditorByteRangeDto> new_affected_byte_ranges;
    AnimationModeDto animation_mode;
    u64 duration_ms;
    CoordinatedCursorDto coordinated_cursor;
    // #606: Core 计算的 old/new 正文偏移映射，平台端 AffectedLayoutPlanner 不再独立推导
    OffsetMapDto? offset_map;
};

dictionary EditorByteRangeDto {
    u32 start;
    u32 end_exclusive;
};

// #606: 动画切片角色 — 与 Core `AnimatedSliceRole` 一一对应。
enum AnimatedSliceRoleDto {
    "Insert",
    "Delete",
    "Move",
    "CrossfadeOld",
    "CrossfadeNew"
};

// #606: Rebase slice 继续/结束语义 — 与 Core `RebaseContinuation` 一一对应。
enum RebaseContinuationDto {
    "Continue",
    "End"
};

// #606: Rebase 匹配依据 — 与 Core `RebaseReason` 一一对应。
enum RebaseReasonDto {
    "SameByteRange",
    "OffsetMapMatched",
    "NoMapping"
};

// #606: 旧→新逻辑 slice 对应关系 — 与 Core `RebaseSliceMapping` 一一对应。
dictionary RebaseSliceMappingDto {
    u32 old_slice_index;
    u32 new_slice_index;
    RebaseContinuationDto continuation;
    RebaseReasonDto reason;
};

dictionary DisplayPatchDto {
    u64 base_revision;
    u64 new_revision;
    u32 replace_byte_start;
    u32 replace_byte_end_exclusive;
    string inserted_text;
    u32 resulting_selection_start;
    u32 resulting_selection_end;
};

enum EditorEditOutcomeDto {
    "Applied",
    "AppliedWithAdjustedSelection",
    "NoChange",
    "StaleRevision",
    "InvalidOffset",
    "InvalidRange"
};

dictionary EditorContentDeltaDto {
    u32 inserted_chars;
    u32 deleted_chars;
    u32 inserted_non_whitespace_chars;
    u32 deleted_non_whitespace_chars;
};

dictionary EditorEditResultDto {
    EditorEditOutcomeDto outcome;
    u64 transaction_id;
    u64 base_revision;
    u64 new_revision;
    sequence<DisplayPatchDto> display_patches;
    u32 old_selection_start;
    u32 old_selection_end;
    u32 new_selection_start;
    u32 new_selection_end;
    EditorVisualIntentDto visual_intent;
    CompositionSessionDto? composition_session;
    // #624 评论8：本次编辑的字符增量（正文无变化时为全 0）。
    EditorContentDeltaDto content_delta;
};

dictionary CompositionSessionDto {
    u64 session_id;
    u64 base_revision;
    u64 generation;
};

dictionary EditorSessionSnapshotDto {
    string text;
    u64 revision;
    u32 cursor;
    u32 selection_anchor;
    u64 generation;
     string chapter_id;
};
