namespace writer_core {
    [Throws=WriterError]
    WriterAppService open_app_service(string app_data_root, string projects_root);

    [Throws=WriterError]
    WriterAppService open_app_service_with_init(string app_data_root, string projects_root, PlatformInitDto init);
};

dictionary AiActionResponse {
    string display_text;
    sequence<AiAction> actions;
};

dictionary AiAction {
    string label;
    AiActionType action_type;
    string payload;
};

enum AiActionType {
    "Navigate",
    "ApplySetting",
    "InsertText",
    "ReplaceText",
    "RunCommand",
    "Custom",
};

dictionary ProjectDto {
    string id;
    string title;
    string created_at;
    string updated_at;
};

dictionary ProjectStatsDto {
    u32 total_word_count;
    u32 volume_count;
    u32 chapter_count;
};

dictionary VolumeDto {
    string id;
    string title;
    string created_at;
    string updated_at;
    i32 order;
};

dictionary ChapterMetaDto {
    string id;
    string title;
    string created_at;
    string updated_at;
    i32 order;
    u32 word_count;
    string hash;
    string? note;
};

dictionary ChapterContentDto {
    ChapterMetaDto meta;
    string content;
};

dictionary ChapterSaveReceiptDto {
    string chapter_relative_path;
    u32 content_len;
    string content_hash;
    string meta_hash;
    string updated_at;
    u32 word_count;
};

dictionary RecentEditDto {
    string project_id;
    string volume_id;
    string chapter_id;
    string timestamp;
};

dictionary LocalSettingsDto {
    string? theme_mode;
    string appearance_mode;
    string color_source;
    boolean dynamic_color_enabled;
    string selected_builtin_theme_id;
    string selected_palette_id;
    string? locale;
    boolean auto_save_enabled;
    f32 editor_font_size;
    f32 editor_line_spacing_multiplier;
    f32 window_width;
    f32 window_height;
    u64 auto_save_delay_ms;
    boolean auto_indent_enabled;
    f32 auto_indent_width;
    boolean editor_typing_animation_enabled;
    boolean editor_smooth_cursor_enabled;
    u64 editor_typing_animation_duration_ms;
    u64 editor_smooth_cursor_duration_ms;
    boolean ai_enabled;
    string? stats_device_id;
    f64 desktop_sidebar_width;
    f64 desktop_editor_width;
    boolean editor_coordinated_text_cursor_animation_enabled;
    boolean diagnostics_enabled;
    boolean diagnostics_verbose;
};

dictionary SyncableSettingsDto {
    f64 font_size;
    string theme_mode;
    string monet_color;
    string theme_palette_json;
};

dictionary ThemeColorSchemeDto {
    string primary;
    string on_primary;
    string primary_container;
    string on_primary_container;
    string inverse_primary;
    string secondary;
    string on_secondary;
    string secondary_container;
    string on_secondary_container;
    string tertiary;
    string on_tertiary;
    string tertiary_container;
    string on_tertiary_container;
    string background;
    string on_background;
    string surface;
    string on_surface;
    string surface_variant;
    string on_surface_variant;
    string surface_tint;
    string surface_dim;
    string surface_bright;
    string surface_container_lowest;
    string surface_container_low;
    string surface_container;
    string surface_container_high;
    string surface_container_highest;
    string inverse_surface;
    string inverse_on_surface;
    string error;
    string on_error;
    string error_container;
    string on_error_container;
    string outline;
    string outline_variant;
    string scrim;
    string primary_fixed;
    string primary_fixed_dim;
    string on_primary_fixed;
    string on_primary_fixed_variant;
    string secondary_fixed;
    string secondary_fixed_dim;
    string on_secondary_fixed;
    string on_secondary_fixed_variant;
    string tertiary_fixed;
    string tertiary_fixed_dim;
    string on_tertiary_fixed;
    string on_tertiary_fixed_variant;
};

dictionary ThemePaletteRecordDto {
    u32 schema_version;
    string palette_id;
    string palette_fingerprint;
    string source;
    string source_platform;
    string source_device_id;
    string source_device_class;
    i64 captured_at_ms;
    string variant;
    ThemeColorSchemeDto light_scheme;
    ThemeColorSchemeDto dark_scheme;
};

dictionary BuiltinThemeDto {
    string theme_id;
    string name;
    ThemeColorSchemeDto light_scheme;
    ThemeColorSchemeDto dark_scheme;
};

dictionary DeviceInfoDto {
    string device_id;
    string device_class;
    string platform;
};

dictionary SyncConfigDto {
    boolean enabled;
    string backend_type;
    string remote_url;
    string transport;
    string branch;
    boolean auto_sync;
    u32 sync_interval_seconds;
    string username;
    boolean has_network_permission;
    boolean has_network_state_permission;
};

dictionary SyncSecretsDto {
    string? token;
};

dictionary SyncConflictDto {
    string local_path;
    string remote_path;
    string local_hash;
    string remote_hash;
    string base_hash;
    i64 created_at;
    string description;
};

dictionary SyncStateDto {
    string status;
    string? remote_url;
    string? backend_type;
    string? transport;
    string? last_synced_commit;
    i64? last_sync_time;
    string? last_error;
    sequence<SyncConflictDto>? conflicts;
};

dictionary SyncDiagnosticsResultDto {
    boolean success;
    string backend_type;
    boolean has_network_permission;
    boolean has_network_state_permission;
    string network_state;
    boolean network_ok;
    boolean auth_ok;
    boolean repo_ok;
    boolean branch_ok;
    string network_status;
    string auth_status;
    string repo_status;
    string branch_status;
    string remote_url_sanitized;
    string transport;
    string error_category;
    string? raw_error;
};

dictionary SyncCapabilityDto {
    boolean can_run;
    string? block_reason_code;
    string? block_message_key;
    record<string, string> message_args;
};

dictionary SyncOperationCountsDto {
    u32 uploaded;
    u32 downloaded;
    u32 local_deleted;
    u32 remote_deleted;
    u32 overwritten;
    u32 ignored;
    u32 conflicts;
};

dictionary SyncOperationStateDto {
    string operation_id;
    string operation_kind;
    string status_code;
    string? phase_key;
    string? summary_key;
    record<string, string> summary_args;
    SyncOperationCountsDto counts;
    string? raw_error;
};

dictionary SyncPlanDto {
    sequence<string> files_to_upload;
    sequence<string> files_to_download;
    sequence<string> files_to_delete_local;
    sequence<string> files_to_delete_remote;
    sequence<string> ignored_files;
    sequence<string> conflicts;
};

dictionary SyncResultDto {
    string status;
    sequence<string> uploaded_files;
    sequence<string> downloaded_files;
    sequence<string> local_deletes;
    sequence<string> remote_deletes;
    sequence<string> overwritten_files;
    sequence<string> ignored_files;
    sequence<SyncConflictDto> conflicts;
    string? commit_hash;
    string? error;
    string? error_category;
    string? message_key;
    string first_sync_mode;
    string? search_index_rebuild_error;
};

[Error]
enum WriterError {
    "Io",
    "Json",
    "ProjectNotFound",
    "VolumeNotFound",
    "ChapterNotFound",
    "EmptyOverwriteBlocked",
    "NotImplemented",
    "RefuseToDeleteRoot",
    "InvalidDeleteTarget",
    "SyncConflict",
    "SyncFailed",
    "RetryableNetwork",
    "RetryableIo",
    "Authentication",
    "Conflict",
    "DirtyRepository",
    "Protocol",
    "Fatal",
    "Other"
};

[Error]
interface SecureStorageError {
    KeystoreKeyInvalidated();
    KeystoreError();
    StorageError();
    MigrationError(string reason);
};

enum PlatformDto {
    "Desktop",
    "Android",
    "Windows",
    "Harmony",
    "Apple",
};

dictionary PlatformInitDto {
    PlatformDto platform;
    string app_data_dir;
    string cache_dir;
    string log_dir;
    string? no_backup_dir;
    string device_id;
    string app_version;
    string locale;
    string timezone;
    boolean is_connected;
    boolean is_metered;
    string? proxy_host;
    u16? proxy_port;
};

dictionary DateRangeDto {
    string start_date;
    string end_date;
};

dictionary WritingStatsSummaryDto {
    DateRangeDto range;
    u64 total_human_typed_chars;
    u64 total_pasted_chars;
    u64 total_deleted_chars;
    u64 total_ai_inserted_chars;
    i64 total_net_delta_chars;
    u64 total_active_seconds;
    u32 total_sessions;
    u32 days_count;
};

dictionary ProjectStatsRecordDto {
    string project_id;
    u64 human_typed_chars;
    u64 pasted_chars;
    u64 deleted_chars;
    u64 ai_inserted_chars;
    i64 net_delta_chars;
    u64 active_seconds;
};

dictionary ProjectStatsSummaryDto {
    DateRangeDto range;
    sequence<ProjectStatsRecordDto> projects;
};

dictionary ChapterStatsRecordDto {
    string chapter_id;
    u64 human_typed_chars;
    u64 pasted_chars;
    u64 deleted_chars;
    u64 ai_inserted_chars;
    i64 net_delta_chars;
    u64 active_seconds;
};

dictionary ChapterStatsSummaryDto {
    DateRangeDto range;
    sequence<ChapterStatsRecordDto> chapters;
};

dictionary DeviceStatsRecordDto {
    string device_id;
    PlatformDto platform;
    string device_class;
    u64 human_typed_chars;
    u64 pasted_chars;
    u64 deleted_chars;
    u64 ai_inserted_chars;
    i64 net_delta_chars;
    u64 active_seconds;
    u32 sessions_count;
};

dictionary DeviceStatsSummaryDto {
    DateRangeDto range;
    sequence<DeviceStatsRecordDto> devices;
};

dictionary SpeedCurvePointDto {
    i64 start_ms;
    i64 end_ms;
    u32 chars_typed;
    float chars_per_minute;
};

dictionary SpeedCurveSummaryDto {
    DateRangeDto range;
    u32 bucket_minutes;
    sequence<SpeedCurvePointDto> buckets;
};

// ============================================================
// StarMap types
// ============================================================

dictionary StarMapMetaDto {
    string starmap_id;
    string title;
    string description;
    string? project_id;
    string? parent_starmap_id;
    boolean is_main_for_project;
    string accent_color;
    u64 created_at;
    u64 updated_at;
    u32 node_count;
    u32 edge_count;
    u32 linked_chapter_count;
    u32 child_starmap_count;
};

dictionary StarMapGraphDto {
    u32 schema_version;
    string id;
    string starmap_id;
    string title;
    sequence<StarMapNodeDto> nodes;
    sequence<StarMapEdgeDto> edges;
    sequence<StarMapEmbedDto> embeds;
    sequence<StarMapLinkDto> links;
    sequence<StarMapHyperlinkDto> hyperlinks;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapNodeDto {
    string id;
    string title;
    StarMapNodeKindDto kind;
    string? payload;
    sequence<string> tags;
    StarMapNodeContentDto content;
    sequence<StarMapAnchorDto> anchors;
    StarMapPortalDto? portal;
    StarMapDisplayPolicyDto display_policy;
    StarMapOpenBehaviorDto open_behavior;
    StarMapProvenanceDto provenance;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapNodeContentDto {
    string kind;
    string? summary;
    string? body;
    string? project_id;
    string? volume_id;
    string? chapter_id;
    u32? range_start;
    u32? range_end;
    string? entity_type;
    string? entity_id;
    string? uri;
    string? label;
};

dictionary StarMapAnchorDto {
    string anchor_id;
    StarMapAnchorTargetDto target;
    string? label;
    StarMapAnchorRoleDto role;
};

dictionary StarMapAnchorTargetDto {
    string kind;
    string? project_id;
    string? volume_id;
    string? chapter_id;
    u32? range_start;
    u32? range_end;
    string? entity_id;
    string? entity_type;
    string? starmap_id;
    string? uri;
    string? payload;
};

dictionary StarMapPortalDto {
    string target_starmap_id;
    StarMapDeepTargetDto? deep_target;
    StarMapPortalModeDto mode;
    StarMapPortalPreviewPolicyDto preview_policy;
};

dictionary StarMapDisplayPolicyDto {
    float importance;
    float min_visible_scale;
    float title_scale;
    float summary_scale;
    float detail_scale;
    u32 max_preview_chars;
    float min_readable_px;
};

dictionary StarMapProvenanceDto {
    StarMapSourceKindDto source;
    string? source_id;
    string? generated_by;
    string? prompt_id;
    StarMapReviewStatusDto review_status;
    string? created_from_anchor;
};

dictionary StarMapDeepTargetDto {
    string starmap_id;
    sequence<StarMapPathSegmentDto> path;
    StarMapTargetDetailDto target;
};

dictionary StarMapPathSegmentDto {
    string kind;
    string? starmap_id;
};

dictionary StarMapEdgeEndpointDto {
    string kind;
    string? node_id;
    string? anchor_id;
    StarMapDeepTargetDto? target;
};

dictionary StarMapEndpointPathSegmentDto {
    string kind;
    string? starmap_id;
};

dictionary StarMapEndpointPathDto {
    sequence<StarMapEndpointPathSegmentDto> segments;
    StarMapEdgeEndpointDto endpoint;
};

dictionary StarMapEdgeDto {
    string id;
    string? from;
    string? to;
    StarMapEdgeKindDto kind;
    string? label;
    string? payload;
    StarMapDeepTargetDto? from_target;
    StarMapDeepTargetDto? to_target;
    StarMapEdgeEndpointDto? from_endpoint;
    StarMapEdgeEndpointDto? to_endpoint;
    StarMapEndpointPathDto? from_endpoint_path;
    StarMapEndpointPathDto? to_endpoint_path;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapEmbedPlacementDto {
    float x;
    float y;
    float width;
    float height;
    float scale;
    i32 z_index;
    boolean collapsed;
};

dictionary StarMapEmbedViewportDto {
    float scale;
    float offset_x;
    float offset_y;
};

dictionary StarMapEmbedDto {
    string instance_id;
    string target_starmap_id;
    string? label;
    StarMapDisplayPolicyDto display_policy;
    StarMapOpenBehaviorDto open_behavior;
    StarMapEmbedPlacementDto placement;
    StarMapEmbedViewportDto target_viewport;
    string? source_node_id;
    StarMapEndpointDto? host_endpoint;
    StarMapProvenanceDto provenance;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapLinkDto {
    string link_id;
    StarMapEndpointDto source;
    StarMapDeepTargetDto target;
    string? label;
    u64 created_at;
    u64 updated_at;
};

dictionary LoadDiagnosticDto {
    string kind;
    string object_type;
    string object_id;
    string? detail;
};

dictionary StarMapLinkListWithDiagnosticsDto {
    sequence<StarMapLinkDto> items;
    sequence<LoadDiagnosticDto> diagnostics;
};

dictionary StarMapHyperlinkDto {
    string hyperlink_id;
    StarMapEndpointPathDto source;
    string target_uri;
    string? label;
    string? target_starmap_id;
    u64 created_at;
    u64 updated_at;
};

dictionary StarMapHyperlinkPatchInputDto {
    string? label;
    boolean clear_label;
    string? target_uri;
    boolean clear_target_uri;
};

dictionary StarMapHyperlinkListWithDiagnosticsDto {
    sequence<StarMapHyperlinkDto> items;
    sequence<LoadDiagnosticDto> diagnostics;
};

dictionary PhasedSnapshotRequestDto {
    string target_phase;
    u64 since_revision;
};

dictionary StarMapPhasedSnapshotDto {
    string starmap_id;
    string title;
    string load_phase;
    u64 package_revision;
    boolean complete;
    u64 since_revision;
    sequence<StarMapNodeDto> nodes;
    sequence<StarMapEdgeDto> edges;
    sequence<StarMapEmbedDto> embeds;
    sequence<StarMapLinkDto> links;
    sequence<StarMapHyperlinkDto> hyperlinks;
    sequence<string> deleted_node_ids;
    sequence<string> deleted_edge_ids;
    sequence<string> deleted_embed_ids;
    sequence<string> deleted_link_ids;
    sequence<string> deleted_hyperlink_ids;
    StarMapLayoutDto? layout;
    StarMapViewportDto? viewport;
    sequence<LoadDiagnosticDto> diagnostics;
};

dictionary StarMapLayoutDto {
    StarMapLayoutKindDto kind;
    sequence<StarMapLayoutNodeDto> nodes;
};

dictionary StarMapLayoutNodeDto {
    string node_id;
    float x;
    float y;
    float width;
    float height;
    float radius;
    boolean collapsed;
    i32 z_index;
    float scale;
    float depth;
    float focus_weight;
    string? orbit_group;
};

dictionary StarMapEdgeRenderDto {
    string edge_id;
    float from_cx;
    float from_cy;
    float to_cx;
    float to_cy;
    float start_x;
    float start_y;
    float end_x;
    float end_y;
    float offset_x;
    float offset_y;
    float arrow_tip_x;
    float arrow_tip_y;
    float arrow_left_x;
    float arrow_left_y;
    float arrow_right_x;
    float arrow_right_y;
    float label_x;
    float label_y;
    string? label;
    boolean has_bidirectional;
};

dictionary StarMapReferenceDto {
    string host_starmap_id;
    string host_title;
    string ref_type;
    string ref_id;
    string target_starmap_id;
};

dictionary StarMapTargetDetailDto {
    string kind;
    string? node_id;
    string? anchor_id;
    string? project_id;
    string? volume_id;
    string? chapter_id;
    u32? range_start;
    u32? range_end;
    string? entity_type;
    string? entity_id;
    string? uri;
};

dictionary StarMapEndpointDto {
    string kind;
    string? node_id;
    string? anchor_id;
};

dictionary StarMapViewportDto {
    float scale;
    float offset_x;
    float offset_y;
    float width;
    float height;
};

dictionary StarMapEmbedPatchInputDto {
    string? label;
    boolean clear_label;
    StarMapDisplayPolicyDto? display_policy;
    StarMapOpenBehaviorDto? open_behavior;
    StarMapViewportDto? viewport;
    boolean clear_viewport;
    StarMapEmbedPlacementDto? placement;
    boolean clear_placement;
    StarMapEmbedViewportDto? target_viewport;
    boolean clear_target_viewport;
    string? source_node_id;
    boolean clear_source_node_id;
    string? host_anchor;
    boolean clear_host_anchor;
    StarMapEndpointDto? host_endpoint;
    boolean clear_host_endpoint;
};

dictionary StarMapLinkPatchInputDto {
    StarMapEndpointDto? source;
    StarMapDeepTargetDto? target;
    string? label;
    boolean clear_label;
};

dictionary StarMapNodePatchInputDto {
    string? title;
    StarMapNodeKindDto? kind;
    string? payload;
    boolean clear_payload;
    sequence<string>? tags;
};

dictionary StarMapEdgePatchInputDto {
    StarMapEdgeKindDto? kind;
    string? label;
    boolean clear_label;
};

enum StarMapNodeKindDto {
    "Character",
    "Event",
    "Location",
    "Item",
    "Concept",
    "Theme",
    "Note",
    "Organization",
    "Timeline",
    "Plot",
    "Foreshadowing",
    "Chapter",
    "Custom",
};

enum StarMapEdgeKindDto {
    "Contains",
    "References",
    "AppearsIn",
    "Causes",
    "RelatedTo",
    "LocatedAt",
    "CharacterRelation",
    "Timeline",
    "Foreshadows",
    "Resolves",
    "DependsOn",
    "ConflictsWith",
    "Custom",
};

enum StarMapLayoutKindDto {
    "Freeform",
    "AutoRadial",
    "Custom",
};

enum StarMapAnchorRoleDto {
    "Source",
    "Destination",
    "Reference",
    "Custom",
};

enum StarMapPortalModeDto {
    "EnterChild",
    "PreviewInline",
    "ReferenceOnly",
};

enum StarMapPortalPreviewPolicyDto {
    "Auto",
    "Always",
    "Never",
};

enum StarMapOpenBehaviorDto {
    "Inspector",
    "ExpandCard",
    "WritingMode",
    "JumpToAnchor",
    "EnterPortal",
    "Custom",
};

enum StarMapSourceKindDto {
    "Human",
    "Import",
    "Plugin",
    "Ai",
    "System",
    "Unknown",
};

enum StarMapReviewStatusDto {
    "Accepted",
    "Draft",
    "NeedsReview",
    "Rejected",
    "Unknown",
};

dictionary StarMapMotionPolicyDto {
    boolean enabled;
    boolean idle_wobble_enabled;
    float idle_amplitude_vp;
    u32 idle_period_ms;
    float drag_lift_scale;
    float drag_shadow_boost;
    u32 settle_duration_ms;
    boolean reduce_motion;
};

// ============================================================
// Action types
// ============================================================

enum ActionKindDto {
    "Query",
    "Preview",
    "Mutation",
};

enum ActionRiskLevelDto {
    "SafeRead",
    "SafeWrite",
    "ContentWrite",
    "Dangerous",
};

dictionary ActionDescriptorDto {
    string id;
    string title;
    string description;
    string category;
    ActionKindDto kind;
    ActionRiskLevelDto risk_level;
    boolean confirm_required;
    boolean undoable;
    sequence<string> platforms;
    string? input_schema;
    string? ui_schema;
};

dictionary ActionResultDto {
    boolean success;
    string? message;
    string? data;
    string? proposed_ui;
    boolean? requires_confirmation;
};

interface WriterAppService {
    constructor(string app_data_root, string projects_root);

    [Throws=WriterError]
    sequence<ProjectDto> list_projects();

        [Throws=WriterError]
    sequence<RecentEditDto> get_recent_edits();

    [Throws=WriterError]
    boolean record_recent_edit(string project_id, string volume_id, string chapter_id);

    [Throws=WriterError]
    boolean flush_recent_edits();

    [Throws=WriterError]
    ProjectDto create_project(string title);

    [Throws=WriterError]
    ProjectStatsDto get_project_stats(string project_id);

    [Throws=WriterError]
    boolean rename_project(string project_id, string new_title);

    [Throws=WriterError]
    boolean delete_project(string project_id);

    [Throws=WriterError]
    boolean reorder_projects(sequence<string> ordered_project_ids);

    [Throws=WriterError]
    sequence<VolumeDto> list_volumes(string project_id);

    [Throws=WriterError]
    VolumeDto create_volume(string project_id, string title);

    [Throws=WriterError]
    boolean rename_volume(string project_id, string volume_id, string new_title);

    [Throws=WriterError]
    boolean delete_volume(string project_id, string volume_id);

    [Throws=WriterError]
    boolean reorder_volumes(string project_id, sequence<string> ordered_volume_ids);

    [Throws=WriterError]
    sequence<ChapterMetaDto> list_chapters(string project_id, string volume_id);

    [Throws=WriterError]
    ChapterMetaDto create_chapter(string project_id, string volume_id, string title);

    [Throws=WriterError]
    ChapterMetaDto create_chapter_in_project(string project_id, string title);

    [Throws=WriterError]
    boolean rename_chapter(string project_id, string volume_id, string chapter_id, string new_title);

    [Throws=WriterError]
    boolean delete_chapter(string project_id, string volume_id, string chapter_id);

    [Throws=WriterError]
    boolean reorder_chapters(string project_id, string volume_id, sequence<string> ordered_chapter_ids);

    [Throws=WriterError]
    ChapterContentDto open_chapter(string project_id, string volume_id, string chapter_id);

    [Throws=WriterError]
    ChapterSaveReceiptDto save_chapter_content(string project_id, string volume_id, string chapter_id, string content);

    [Throws=WriterError]
    ChapterSaveReceiptDto clear_chapter_content(string project_id, string volume_id, string chapter_id);

    [Throws=WriterError]
    boolean update_chapter_note(string project_id, string volume_id, string chapter_id, string note);

    [Throws=WriterError]
    LocalSettingsDto load_local_settings();

    [Throws=WriterError]
    boolean save_local_settings(LocalSettingsDto settings);

    [Throws=WriterError]
    SyncableSettingsDto load_syncable_settings();

    [Throws=WriterError]
    boolean save_syncable_settings(SyncableSettingsDto settings);

    [Throws=WriterError]
    SyncConfigDto load_sync_config(string project_id);

    [Throws=WriterError]
    boolean save_sync_config(string project_id, SyncConfigDto config);

    [Throws=WriterError]
    SyncSecretsDto load_sync_secrets(string project_id);

