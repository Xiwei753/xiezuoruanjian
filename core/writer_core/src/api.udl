// ============================================================
// Action types
// ============================================================

enum ActionKindDto {
    "Query",
    "Preview",
    "Mutation",
};

enum ActionRiskLevelDto {
    "SafeRead",
    "SafeWrite",
    "ContentWrite",
    "Dangerous",
};

dictionary ActionDescriptorDto {
    string id;
    string title;
    string description;
    string category;
    ActionKindDto kind;
    ActionRiskLevelDto risk_level;
    boolean confirm_required;
    boolean undoable;
    sequence<string> platforms;
    string? input_schema;
    string? ui_schema;
};

dictionary ActionResultDto {
    boolean success;
    string? message;
    string? data;
    string? proposed_ui;
    boolean? requires_confirmation;
};

interface WriterAppService {
    constructor(string workspace_path);

    [Throws=WriterError]
    sequence<ProjectDto> list_projects();

    [Throws=WriterError]
    boolean create_workspace_if_needed();

    [Throws=WriterError]
    boolean validate_workspace();

    [Throws=WriterError]
    sequence<RecentEditDto> get_recent_edits();

    [Throws=WriterError]
    boolean record_recent_edit(string project_id, string volume_id, string chapter_id);

    [Throws=WriterError]
    ProjectDto create_project(string title);

    [Throws=WriterError]
    ProjectStatsDto get_project_stats(string project_id);

    [Throws=WriterError]
    boolean rename_project(string project_id, string new_title);

    [Throws=WriterError]
    boolean delete_project(string project_id);

    [Throws=WriterError]
    boolean reorder_projects(sequence<string> ordered_project_ids);

    [Throws=WriterError]
    sequence<VolumeDto> list_volumes(string project_id);

    [Throws=WriterError]
    VolumeDto create_volume(string project_id, string title);

    [Throws=WriterError]
    boolean rename_volume(string project_id, string volume_id, string new_title);

    [Throws=WriterError]
    boolean delete_volume(string project_id, string volume_id);

    [Throws=WriterError]
    boolean reorder_volumes(string project_id, sequence<string> ordered_volume_ids);

    [Throws=WriterError]
    sequence<ChapterMetaDto> list_chapters(string project_id, string volume_id);

    [Throws=WriterError]
    ChapterMetaDto create_chapter(string project_id, string volume_id, string title);

    [Throws=WriterError]
    boolean rename_chapter(string project_id, string volume_id, string chapter_id, string new_title);

    [Throws=WriterError]
    boolean delete_chapter(string project_id, string volume_id, string chapter_id);

    [Throws=WriterError]
    boolean reorder_chapters(string project_id, string volume_id, sequence<string> ordered_chapter_ids);

    [Throws=WriterError]
    ChapterContentDto open_chapter(string project_id, string volume_id, string chapter_id);

    [Throws=WriterError]
    ChapterSaveReceiptDto save_chapter_content(string project_id, string volume_id, string chapter_id, string content);

    [Throws=WriterError]
    ChapterSaveReceiptDto clear_chapter_content(string project_id, string volume_id, string chapter_id);

    [Throws=WriterError]
    boolean update_chapter_note(string project_id, string volume_id, string chapter_id, string note);

    [Throws=WriterError]
    LocalSettingsDto load_local_settings();

    [Throws=WriterError]
    boolean save_local_settings(LocalSettingsDto settings);

    string save_local_settings_envelope_json(LocalSettingsDto settings);

    [Throws=WriterError]
    SyncableSettingsDto load_syncable_settings();

    [Throws=WriterError]
    boolean save_syncable_settings(SyncableSettingsDto settings);

    string save_syncable_settings_envelope_json(SyncableSettingsDto settings);

    [Throws=WriterError]
    SyncConfigDto load_sync_config();

    [Throws=WriterError]
    boolean save_sync_config(SyncConfigDto config);

    [Throws=WriterError]
    SyncSecretsDto load_sync_secrets();

    [Throws=WriterError]
    boolean save_sync_secrets(SyncSecretsDto secrets);

    [Throws=WriterError]
    SyncStateDto load_sync_state();

    [Throws=WriterError]
    SyncDiagnosticsResultDto perform_sync_diagnostics(SyncConfigDto config);

    [Throws=WriterError]
    SyncPlanDto perform_sync_dry_run(SyncConfigDto config);

    [Throws=WriterError]
    SyncResultDto perform_sync(SyncConfigDto config);

    string perform_sync_envelope_json(SyncConfigDto config);

    string perform_sync_dry_run_envelope_json(SyncConfigDto config);

    string perform_sync_diagnostics_envelope_json(SyncConfigDto config);

    string save_sync_config_envelope_json(SyncConfigDto config);

    string save_sync_secrets_envelope_json(SyncSecretsDto secrets);

    string save_chapter_content_envelope_json(string project_id, string volume_id, string chapter_id, string content);

    string delete_project_envelope_json(string project_id);

    string delete_volume_envelope_json(string project_id, string volume_id);

    string delete_chapter_envelope_json(string project_id, string volume_id, string chapter_id);

    [Throws=WriterError]
    WritingStatsSummaryDto get_writing_stats_summary(string start_date, string end_date);

    [Throws=WriterError]
    ProjectStatsSummaryDto get_writing_stats_by_project(string start_date, string end_date);

    [Throws=WriterError]
    ChapterStatsSummaryDto get_writing_stats_by_chapter(string start_date, string end_date);

    [Throws=WriterError]
    DeviceStatsSummaryDto get_writing_stats_by_device(string start_date, string end_date);

    [Throws=WriterError]
    SpeedCurveSummaryDto get_writing_speed_curve(string start_date, string end_date, u32 bucket_minutes);

    u32 calculate_word_count(string text);

    [Throws=WriterError]
    boolean process_writing_event(string device_id, string platform, string project_id, string volume_id, string chapter_id, string old_text, string new_text, string session_id);

    [Throws=WriterError]
    boolean record_writing_event(string device_id, string project_id, string volume_id, string chapter_id, string source, i32 inserted_chars, i32 deleted_chars, i32 pasted_chars, i32 ai_inserted_chars, string session_id);

    [Throws=WriterError]
    boolean flush_writing_stats();

    // MindMap typed methods
    [Throws=WriterError]
    MindMapSnapshotDto get_mindmap_snapshot(string project_id);

    [Throws=WriterError]
    boolean save_mindmap_graph(string project_id, MindMapGraphDto graph);

    // StarMap typed methods
    [Throws=WriterError]
    sequence<StarMapMetaDto> list_starmaps();

    [Throws=WriterError]
    StarMapMetaDto create_starmap(string title, string desc);

    [Throws=WriterError]
    StarMapGraphDto get_starmap_graph(string starmap_id);

    [Throws=WriterError]
    StarMapNodeDto add_starmap_node(string starmap_id, StarMapNodeDto node, float x, float y);

    [Throws=WriterError]
    boolean save_starmap_layout(string starmap_id, StarMapLayoutDto layout);

    [Throws=WriterError]
    StarMapEmbedDto add_starmap_embed(string starmap_id, StarMapEmbedDto embed);

    [Throws=WriterError]
    StarMapEmbedDto update_starmap_embed(string starmap_id, string instance_id, StarMapEmbedPatchInputDto patch);

    [Throws=WriterError]
    boolean delete_starmap_embed(string starmap_id, string instance_id);

    [Throws=WriterError]
    StarMapLinkDto add_starmap_link(string starmap_id, StarMapLinkDto link);

    [Throws=WriterError]
    StarMapLinkDto update_starmap_link(string starmap_id, string link_id, StarMapLinkPatchInputDto patch);

    [Throws=WriterError]
    boolean delete_starmap_link(string starmap_id, string link_id);

    [Throws=WriterError]
    sequence<StarMapReferenceDto> find_starmap_references(string target_starmap_id);

    [Throws=WriterError]
    sequence<ActionDescriptorDto> list_registered_actions();

    [Throws=WriterError]
    ActionResultDto execute_action(string action_id, string args_json, string context_json);

    boolean ai_available();
};
